# Copy this file to .env and edit. Every value is optional for local development.
PORT=3001

# Set to true when the site is served over https (cookies then get the Secure flag).
COOKIE_SECURE=false

# Set to 1 if you run behind a reverse proxy (nginx, Render, Railway...) so client IPs are read correctly.
TRUST_PROXY=

# Where the database file lives (default: ./data/db.json).
# DB_FILE=./data/db.json

# Password-reset emails. Leave empty in development: the 6-digit code is then printed in the server
# console and shown on the reset page. When SMTP_URL is set, codes are only emailed, never shown.
# Example: smtps://user:password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM="CartWise <no-reply@example.com>"
